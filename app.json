{
  "expo": {
    "name": "WildGuess",
    "slug": "wildguess",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "wildguess",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wildguess.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "WildGuess uses your location to suggest species observed near you."
      }
    },
    "android": {
      "package": "com.wildguess.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}